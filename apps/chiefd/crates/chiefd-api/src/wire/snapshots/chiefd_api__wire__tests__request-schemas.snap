  "maint.queue": {
    "$defs": {
      "MaintKind": {
        "description": "What kind of session maintenance is being asked for.",
        "oneOf": [
          {
            "const": "compact",
            "description": "Context compaction.",
            "type": "string"
          }
        ]
      },
      "PersonId": {
        "description": "A person's stable identifier. Never a display name.",
        "type": "string"
      },
      "Slug": {
        "description": "Company slug. Validated against `^[a-z0-9]+(?:-[a-z0-9]+)*$` **before any\npath use** (plan §2.1) — a slug reaches the filesystem only after\n[`Slug::parse`] has accepted it.",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`maint.queue` / `maint.auto_compact`.\n\n`force` ⇔ `companyActionId` coupling (D6): forcing requires a live company\naction, and a company action without force is equally refused. The types\nkeep them separate fields because the refusal must name which half is\nmissing; the pairing is checked in `validate()` and surfaces as\n[`FORCE_COMPANY_ACTION_UNPAIRED`].",
    "properties": {
      "companyActionId": {
        "description": "The live `companyActions` entry backing a forced request.",
        "type": [
          "string",
          "null"
        ]
      },
      "force": {
        "default": false,
        "description": "Force the request even when one is already unresolved.",
        "type": "boolean"
      },
      "kind": {
        "$ref": "#/$defs/MaintKind",
        "description": "What to do."
      },
      "personId": {
        "$ref": "#/$defs/PersonId",
        "description": "Whose session."
      },
      "slug": {
        "$ref": "#/$defs/Slug",
        "description": "The company."
      }
    },
    "required": [
      "slug",
      "personId",
      "kind"
    ],
    "title": "MaintQueueRequest",
    "type": "object"
  },
