  "org.transfer": {
    "$defs": {
      "DepartmentId": {
        "description": "A department's identifier within one company's manifest.",
        "type": "string"
      },
      "PersonId": {
        "description": "A person's stable identifier. Never a display name.",
        "type": "string"
      },
      "PersonRole": {
        "description": "Role of a person within a department.",
        "oneOf": [
          {
            "const": "worker",
            "description": "Individual contributor.",
            "type": "string"
          },
          {
            "const": "manager",
            "description": "Manages a department.",
            "type": "string"
          },
          {
            "const": "executive",
            "description": "The company executive.",
            "type": "string"
          }
        ]
      },
      "Slug": {
        "description": "Company slug. Validated against `^[a-z0-9]+(?:-[a-z0-9]+)*$` **before any\npath use** (plan §2.1) — a slug reaches the filesystem only after\n[`Slug::parse`] has accepted it.",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`org.transfer` — a permanent move.\n\nEffective on the very next call: authorization is checked per call against\na freshly loaded manifest, never derived from the registered toolset\n(plan §3.2).",
    "properties": {
      "personId": {
        "$ref": "#/$defs/PersonId",
        "description": "The person to transfer."
      },
      "role": {
        "anyOf": [
          {
            "$ref": "#/$defs/PersonRole"
          },
          {
            "type": "null"
          }
        ],
        "description": "New role, when the transfer is also a promotion or demotion."
      },
      "slug": {
        "$ref": "#/$defs/Slug",
        "description": "The company."
      },
      "toDepartment": {
        "$ref": "#/$defs/DepartmentId",
        "description": "Destination department."
      }
    },
    "required": [
      "slug",
      "personId",
      "toDepartment"
    ],
    "title": "TransferRequest",
    "type": "object"
  }
