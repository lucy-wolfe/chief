      "slug": {
        "$ref": "#/$defs/Slug",
        "description": "The company."
      }
    },
    "required": [
      "slug"
    ],
    "title": "ActivityStatusRequest",
    "type": "object"
  },
  "company.boot": {
    "$defs": {
      "Slug": {
        "description": "Company slug. Validated against `^[a-z0-9]+(?:-[a-z0-9]+)*$` **before any\npath use** (plan §2.1) — a slug reaches the filesystem only after\n[`Slug::parse`] has accepted it.",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`company.boot` — it names the company and nothing else.\n\n#751-P9: it used to carry an optional, fully-specified runtime target\n(socket + session, D17's unrepresentable-half-set pair). Booting a company\nis a decision about PEOPLE; which terminal socket the operator happens to\nbe attached to is the operator client's own business and never travelled\nusefully — the durable ownership record already answers \"where\", for the\none client that has a \"where\" at all.\n\n`company.ceo` shared this request type until chief-home-is-cwd §4c deleted\nthe verb with the daemon-side CEO boot.",
    "properties": {
      "slug": {
        "$ref": "#/$defs/Slug",
        "description": "The company."
      }
    },
    "required": [
      "slug"
    ],
    "title": "CompanyTargetRequest",
    "type": "object"
  },
  "company.compact": {
    "$defs": {
      "ForceMode": {
        "description": "Whether a compact/reset was requested in force mode. A mode change\nmid-flight is refused; an unresolved same-kind action is reused only when\nthe force mode matches.",
        "oneOf": [
          {
            "const": "normal",
            "description": "Ordinary request.",
            "type": "string"
          },
          {
            "const": "force",
            "description": "Force mode.",
            "type": "string"
          }
        ]
      },
      "Slug": {
        "description": "Company slug. Validated against `^[a-z0-9]+(?:-[a-z0-9]+)*$` **before any\npath use** (plan §2.1) — a slug reaches the filesystem only after\n[`Slug::parse`] has accepted it.",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`company.compact` / `company.reset`.",
    "properties": {
      "force": {
        "$ref": "#/$defs/ForceMode",
        "default": "normal",
        "description": "Force mode. A target the company cannot maintain aborts the whole queue\nregardless."
      },
      "slug": {
        "$ref": "#/$defs/Slug",
        "description": "The company."
      }
    },
    "required": [
      "slug"
    ],
    "title": "CompanyMaintenanceRequest",
    "type": "object"
  },
  "company.create": {
    "$defs": {
      "Slug": {
        "description": "Company slug. Validated against `^[a-z0-9]+(?:-[a-z0-9]+)*$` **before any\npath use** (plan §2.1) — a slug reaches the filesystem only after\n[`Slug::parse`] has accepted it.",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`company.create` — create-once; a duplicate request is refused.\n\nThe slug regex is checked before any path use. `requestedBy` is injected,\nnot carried here.\n\n# The directory is REQUIRED, and it is what makes the request unique\n\nThis carried `dataRoot: Option<PathBuf>` — \"absent means the launcher\ndefault\" — beside a slug that was expected to identify the company on its\nown. Neither half survives: there is no launcher default and no data root,\nand a slug names nothing, because two directories may hold companies with\nthe same name. The DIRECTORY is the company, so it is required and it is\nthe whole of the identity.\n\nA non-normalized path is refused rather than normalized — normalizing would\nmake two different requests claim the same directory.",
    "properties": {
      "dir": {
        "description": "The canonical absolute directory the new company will occupy.",
        "type": "string"
      },
      "slug": {
        "$ref": "#/$defs/Slug",
        "description": "The new company's slug — its display name, not its identity."
      },
      "template": {
        "description": "Organization template name.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "dir",
      "slug"
    ],
    "title": "CompanyCreateRequest",
    "type": "object"
  },
