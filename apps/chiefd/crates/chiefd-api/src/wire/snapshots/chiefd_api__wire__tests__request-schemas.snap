  "maint.finish": {
    "$defs": {
      "MaintClaim": {
        "additionalProperties": false,
        "description": "The claim triple, minted **inside the running Pi** and validated by chiefd,\nwhich can never mint one (plan §4).\n\nEvery fenced maintenance verb carries it. Re-presenting the same triple to\n`maint.start` returns the already-claimed request.",
        "properties": {
          "claimToken": {
            "description": "The claim token.",
            "type": "string"
          },
          "processId": {
            "description": "The Pi process id that minted the claim.",
            "type": "string"
          },
          "sessionId": {
            "description": "The Pi session id.",
            "type": "string"
          }
        },
        "required": [
          "processId",
          "sessionId",
          "claimToken"
        ],
        "type": "object"
      },
      "Slug": {
        "description": "Company slug. Validated against `^[a-z0-9]+(?:-[a-z0-9]+)*$` **before any\npath use** (plan §2.1) — a slug reaches the filesystem only after\n[`Slug::parse`] has accepted it.",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "The fenced maintenance verbs that need only the claim and the request id:\n`interrupt`, `defer`, `recover`, `finish`, `apply`, `complete`.\n\nTOMBSTONE: `complete_native` was a seventh. It completed a company-scoped\nrequest whose only producer was `org_maintain_session`, so with that verb\ngone nothing can reach it.",
    "properties": {
      "claim": {
        "$ref": "#/$defs/MaintClaim",
        "description": "The claim triple that owns the request."
      },
      "requestId": {
        "description": "The request being acted on.",
        "type": "string"
      },
      "slug": {
        "$ref": "#/$defs/Slug",
        "description": "The company."
      }
    },
    "required": [
      "slug",
      "claim",
      "requestId"
    ],
    "title": "MaintFencedRequest",
    "type": "object"
  },
