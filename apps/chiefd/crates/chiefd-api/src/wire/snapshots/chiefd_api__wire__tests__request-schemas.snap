      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "A request that names only a company. Every company-scoped read and simple\nverb uses it, so the disk-authority check (§1) has exactly one shape.",
