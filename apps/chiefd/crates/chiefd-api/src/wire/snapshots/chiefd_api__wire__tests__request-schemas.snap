{
  "activity.status": {
    "$defs": {
      "PersonId": {
        "description": "A person's stable identifier. Never a display name.",
        "type": "string"
      },
      "Slug": {
        "description": "Company slug. Validated against `^[a-z0-9]+(?:-[a-z0-9]+)*$` **before any\npath use** (plan §2.1) — a slug reaches the filesystem only after\n[`Slug::parse`] has accepted it.",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`activity.status` — a pure read.",
    "properties": {
      "personId": {
        "anyOf": [
          {
            "$ref": "#/$defs/PersonId"
          },
          {
            "type": "null"
          }
        ],
        "description": "Whose status to read. Absent means the authenticated caller — the\nperson id is injected, not claimed."
