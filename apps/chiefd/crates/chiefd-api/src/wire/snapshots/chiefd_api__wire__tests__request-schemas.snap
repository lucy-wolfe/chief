  "org.hire": {
    "$defs": {
      "Capability": {
        "description": "A closed capability vocabulary: an enum, with `deny_unknown_fields` plus\nenum exhaustiveness rejecting anything else at the schema boundary, so a\ncapability outside the set cannot arrive as a free-form string.",
        "oneOf": [
          {
            "const": "bash",
            "description": "Shell access. Available to every role.",
            "type": "string"
          },
          {
            "const": "read",
            "description": "Read files in the person's workspace.",
            "type": "string"
          },
          {
            "const": "write",
            "description": "Write files in the person's workspace.",
            "type": "string"
          },
          {
            "const": "web",
            "description": "Web search / fetch.",
            "type": "string"
          },
          {
            "const": "org",
            "description": "Organization tools (send, roster, …).",
            "type": "string"
          }
        ]
      },
      "DepartmentId": {
        "description": "A department's identifier within one company's manifest.",
        "type": "string"
      },
      "IdempotencyKey": {
        "description": "Client-supplied idempotency key for the creating ops that are not\nidempotent on their own arguments — `assignment.assign`, `org.hire`, and\n`goal.set` (plan §6.6). Backed by a unique column, or\nby a key-derived row id, so a retry after an ambiguous connection drop\ncannot double-create.\n\n`goal.set` was **not** on this list until plan §10 Q6 was closed, and its\nabsence was the whole of the durability regression the operator overruled: the store\nhas been idempotent on the goal id since M15, but the wire carried no key to\nderive that id from, so `shim/client.ts` classified the op non-idempotent\nand refused to retry the one failure shape a crash-loop produces. If a\ncreating op is ever added without a key, that is the failure it inherits.",
        "type": "string"
      },
      "PersonRole": {
        "description": "Role of a person within a department.",
        "oneOf": [
          {
            "const": "worker",
            "description": "Individual contributor.",
            "type": "string"
          },
          {
            "const": "manager",
            "description": "Manages a department.",
            "type": "string"
          },
          {
            "const": "executive",
            "description": "The company executive.",
            "type": "string"
          }
        ]
      },
      "Slug": {
        "description": "Company slug. Validated against `^[a-z0-9]+(?:-[a-z0-9]+)*$` **before any\npath use** (plan §2.1) — a slug reaches the filesystem only after\n[`Slug::parse`] has accepted it.",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`org.hire`.\n\nThe complete candidate is materialized in a tmpdir **first** (inv 37): a\npreflight failure advances nothing. Create-once via `idempotencyKey`\n(plan §6.6).",
    "properties": {
      "capabilities": {
        "description": "Capabilities to grant. Every capability is available to every role.",
        "items": {
          "$ref": "#/$defs/Capability"
        },
        "type": "array"
      },
      "department": {
        "$ref": "#/$defs/DepartmentId",
        "description": "Department to hire into."
      },
      "idempotencyKey": {
        "$ref": "#/$defs/IdempotencyKey",
        "description": "Client-supplied create-once key."
      },
      "model": {
        "description": "Model to run the person on. Model selection is free at hire time and\nforever after (`model-switch-freedom`).",
        "type": "string"
      },
      "role": {
        "$ref": "#/$defs/PersonRole",
        "description": "Role for the new person."
      },
      "slug": {
        "$ref": "#/$defs/Slug",
        "description": "The company."
      }
    },
    "required": [
      "slug",
      "department",
      "role",
      "capabilities",
      "model",
      "idempotencyKey"
    ],
    "title": "HireRequest",
    "type": "object"
  },
