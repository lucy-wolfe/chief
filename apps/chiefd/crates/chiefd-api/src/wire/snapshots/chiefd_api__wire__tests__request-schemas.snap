  "org.department.add": {
    "$defs": {
      "DepartmentId": {
        "description": "A department's identifier within one company's manifest.",
        "type": "string"
      },
      "DepartmentSpec": {
        "additionalProperties": false,
        "description": "A department as the manifest describes it.",
        "properties": {
          "charter": {
            "description": "Charter prose handed to the department's people.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/$defs/DepartmentId",
            "description": "Department id."
          },
          "name": {
            "description": "Human-facing name.",
            "type": "string"
          },
          "parent": {
            "anyOf": [
              {
                "$ref": "#/$defs/DepartmentId"
              },
              {
                "type": "null"
              }
            ],
            "description": "Parent department; absent only for the executive root."
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "Slug": {
        "description": "Company slug. Validated against `^[a-z0-9]+(?:-[a-z0-9]+)*$` **before any\npath use** (plan §2.1) — a slug reaches the filesystem only after\n[`Slug::parse`] has accepted it.",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`org.department.add`.",
    "properties": {
      "department": {
        "$ref": "#/$defs/DepartmentSpec",
        "description": "The department to add."
      },
      "slug": {
        "$ref": "#/$defs/Slug",
        "description": "The company."
      }
    },
    "required": [
      "slug",
      "department"
    ],
    "title": "DepartmentAddRequest",
    "type": "object"
  },
