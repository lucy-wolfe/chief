  "msg.send": {
    "$defs": {
      "PersonId": {
        "description": "A person's stable identifier. Never a display name.",
        "type": "string"
      },
      "Slug": {
        "description": "Company slug. Validated against `^[a-z0-9]+(?:-[a-z0-9]+)*$` **before any\npath use** (plan §2.1) — a slug reaches the filesystem only after\n[`Slug::parse`] has accepted it.",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`msg.send`.\n\n`\"launcher\"` is never a recipient — that behavioral debt lives in the shim's\nseparately versioned description catalog, and an unknown recipient is\nrefused here.",
    "properties": {
      "body": {
        "description": "The message. Never omitted.",
        "type": "string"
      },
      "completeAssignment": {
        "description": "Complete this assignment with the message body as its result — the\n**only** route to `assignment.result` for a worker (plan §3.4). The id\nmust be the exact one from the active ASSIGNMENT header.",
        "type": [
          "string",
          "null"
        ]
      },
      "slug": {
        "$ref": "#/$defs/Slug",
        "description": "The company."
      },
      "to": {
        "description": "Recipients. Empty is refused: the repeated-empty-send loop is exactly\nwhat the shim's circuit breaker exists for.",
        "items": {
          "$ref": "#/$defs/PersonId"
        },
        "type": "array"
      }
    },
    "required": [
      "slug",
      "to",
      "body"
    ],
    "title": "MsgSendRequest",
    "type": "object"
  },
