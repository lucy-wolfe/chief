{
  "name": "defer-with-a-mismatched-attested-identity-is-refused",
  "family": "session-maintenance",
  "description": "The ChiefD-injected person must equal the request's own; a mismatch is refused before the claim is even considered.",
  "invariants": [
    "§1 attested-echo"
  ],
  "setup": [
    {
      "op": "company.create",
      "in": {
        "template": "northstar"
      }
    },
    {
      "op": "maint.queue",
      "in": {
        "action": "compact",
        "personId": "signal-researcher",
        "requestedBy": "signal-researcher",
        "reason": "Context is nearly full."
      }
    },
    {
      "op": "maint.start",
      "in": {
        "personId": "signal-researcher",
        "action": "compact",
        "claim": {
          "processId": 4242,
          "sessionId": "session-alpha",
          "claimToken": "token-alpha"
        }
      }
    }
  ],
  "op": "maint.defer",
  "caller": {
    "personId": "quant-head",
    "role": "manager"
  },
  "in": {
    "requestId": "session-maintenance:1:signal-researcher:compact",
    "claim": {
      "processId": 4242,
      "sessionId": "session-alpha",
      "claimToken": "token-alpha"
    }
  },
  "expect": {
    "error": {
      "type": "Refused",
      "code": "identity-echo-mismatch",
      "message": "Session maintenance request does not match the ChiefD-injected person"
    }
  },
  "expectState": [
    {
      "read": "maint.request",
      "args": {
        "requestId": "session-maintenance:1:signal-researcher:compact"
      },
      "equals": {
        "action": "compact",
        "attempt": 1,
        "automatic": false,
        "claimToken": "token-alpha",
        "claimedProcessId": 4242,
        "claimedSessionId": "session-alpha",
        "compactAnchorEntryId": null,
        "compactSessionId": null,
        "completedCompactionEntryId": null,
        "completedSessionId": null,
        "error": null,
        "force": false,
        "id": "session-maintenance:1:signal-researcher:compact",
        "interruptedSessionId": null,
        "personId": "signal-researcher",
        "recoveredFromRequestId": null,
        "requestedBy": "signal-researcher",
        "retryNotBefore": null,
        "status": "running"
      }
    },
    {
      "read": "maint.summary",
      "equals": {
        "requestOrder": [
          "session-maintenance:1:signal-researcher:compact"
        ]
      }
    }
  ]
}
