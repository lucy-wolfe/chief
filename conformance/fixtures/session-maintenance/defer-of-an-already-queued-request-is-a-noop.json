{
  "name": "defer-of-an-already-queued-request-is-a-noop",
  "family": "session-maintenance",
  "description": "Deferring something already back in the queue succeeds without change, so a retry after an ambiguous drop is safe.",
  "invariants": [
    "§2.5 defer"
  ],
  "setup": [
    {
      "op": "company.create",
      "in": {
        "template": "northstar"
      }
    },
    {
      "op": "maint.queue",
      "in": {
        "action": "compact",
        "personId": "signal-researcher",
        "requestedBy": "signal-researcher",
        "reason": "Context is nearly full."
      }
    },
    {
      "op": "maint.start",
      "in": {
        "personId": "signal-researcher",
        "action": "compact",
        "claim": {
          "processId": 4242,
          "sessionId": "session-alpha",
          "claimToken": "token-alpha"
        }
      }
    },
    {
      "op": "maint.defer",
      "in": {
        "requestId": "session-maintenance:1:signal-researcher:compact",
        "claim": {
          "processId": 4242,
          "sessionId": "session-alpha",
          "claimToken": "token-alpha"
        }
      }
    }
  ],
  "op": "maint.defer",
  "in": {
    "requestId": "session-maintenance:1:signal-researcher:compact",
    "claim": {
      "processId": 4242,
      "sessionId": "session-alpha",
      "claimToken": "token-alpha"
    }
  },
  "expect": {
    "ok": {
      "action": "compact",
      "attempt": 1,
      "automatic": false,
      "claimToken": null,
      "claimedProcessId": null,
      "claimedSessionId": null,
      "compactAnchorEntryId": null,
      "compactSessionId": null,
      "completedCompactionEntryId": null,
      "completedSessionId": null,
      "error": null,
      "force": false,
      "id": "session-maintenance:1:signal-researcher:compact",
      "interruptedSessionId": null,
      "personId": "signal-researcher",
      "recoveredFromRequestId": null,
      "requestedBy": "signal-researcher",
      "retryNotBefore": null,
      "status": "queued"
    }
  },
  "expectState": [
    {
      "read": "maint.request",
      "args": {
        "requestId": "session-maintenance:1:signal-researcher:compact"
      },
      "equals": {
        "action": "compact",
        "attempt": 1,
        "automatic": false,
        "claimToken": null,
        "claimedProcessId": null,
        "claimedSessionId": null,
        "compactAnchorEntryId": null,
        "compactSessionId": null,
        "completedCompactionEntryId": null,
        "completedSessionId": null,
        "error": null,
        "force": false,
        "id": "session-maintenance:1:signal-researcher:compact",
        "interruptedSessionId": null,
        "personId": "signal-researcher",
        "recoveredFromRequestId": null,
        "requestedBy": "signal-researcher",
        "retryNotBefore": null,
        "status": "queued"
      }
    },
    {
      "read": "maint.summary",
      "equals": {
        "requestOrder": [
          "session-maintenance:1:signal-researcher:compact"
        ]
      }
    }
  ]
}
