{
  "name": "finish-anchored-compact-with-a-foreign-entry-conflicts",
  "family": "session-maintenance",
  "description": "Once completed by one native compaction entry, a different entry claiming the same request is a conflict.",
  "invariants": [
    "§2.5 finish"
  ],
  "setup": [
    {
      "op": "company.create",
      "in": {
        "template": "northstar"
      }
    },
    {
      "op": "maint.queue",
      "in": {
        "action": "compact",
        "personId": "signal-researcher",
        "requestedBy": "signal-researcher",
        "reason": "Context is nearly full."
      }
    },
    {
      "op": "maint.start",
      "in": {
        "personId": "signal-researcher",
        "action": "compact",
        "claim": {
          "processId": 4242,
          "sessionId": "session-alpha",
          "claimToken": "token-alpha"
        },
        "compactAnchor": {
          "sessionId": "pi-session-1",
          "entryId": "entry-7"
        }
      }
    },
    {
      "op": "maint.finish",
      "in": {
        "requestId": "session-maintenance:1:signal-researcher:compact",
        "status": "completed",
        "compactEntryId": "entry-9"
      }
    }
  ],
  "op": "maint.finish",
  "in": {
    "requestId": "session-maintenance:1:signal-researcher:compact",
    "status": "completed",
    "compactEntryId": "entry-11"
  },
  "expect": {
    "error": {
      "type": "Conflict",
      "code": "compaction-entry-conflict",
      "message": "Session maintenance request 'session-maintenance:1:signal-researcher:compact' was completed by another native compaction entry"
    }
  },
  "expectState": [
    {
      "read": "maint.request",
      "args": {
        "requestId": "session-maintenance:1:signal-researcher:compact"
      },
      "equals": {
        "action": "compact",
        "attempt": 1,
        "automatic": false,
        "claimToken": "token-alpha",
        "claimedProcessId": 4242,
        "claimedSessionId": "session-alpha",
        "compactAnchorEntryId": "entry-7",
        "compactSessionId": "pi-session-1",
        "completedCompactionEntryId": "entry-9",
        "completedSessionId": null,
        "error": null,
        "force": false,
        "id": "session-maintenance:1:signal-researcher:compact",
        "interruptedSessionId": null,
        "personId": "signal-researcher",
        "recoveredFromRequestId": null,
        "requestedBy": "signal-researcher",
        "retryNotBefore": null,
        "status": "completed"
      }
    },
    {
      "read": "maint.summary",
      "equals": {
        "requestOrder": [
          "session-maintenance:1:signal-researcher:compact"
        ]
      }
    }
  ]
}
