{
  "name": "defer-from-a-foreign-claim-conflicts",
  "family": "session-maintenance",
  "description": "An older process or extension installation can never release another runtime's work.",
  "invariants": [
    "§2.5 defer"
  ],
  "setup": [
    {
      "op": "company.create",
      "in": {
        "template": "northstar"
      }
    },
    {
      "op": "maint.queue",
      "in": {
        "action": "compact",
        "personId": "signal-researcher",
        "requestedBy": "signal-researcher",
        "reason": "Context is nearly full."
      }
    },
    {
      "op": "maint.start",
      "in": {
        "personId": "signal-researcher",
        "action": "compact",
        "claim": {
          "processId": 4242,
          "sessionId": "session-alpha",
          "claimToken": "token-alpha"
        }
      }
    }
  ],
  "op": "maint.defer",
  "in": {
    "requestId": "session-maintenance:1:signal-researcher:compact",
    "claim": {
      "processId": 9999,
      "sessionId": "session-beta",
      "claimToken": "token-beta"
    }
  },
  "expect": {
    "error": {
      "type": "Conflict",
      "code": "claim-mismatch",
      "message": "Session maintenance request 'session-maintenance:1:signal-researcher:compact' is not owned by this exact live claim"
    }
  },
  "expectState": [
    {
      "read": "maint.request",
      "args": {
        "requestId": "session-maintenance:1:signal-researcher:compact"
      },
      "equals": {
        "action": "compact",
        "attempt": 1,
        "automatic": false,
        "claimToken": "token-alpha",
        "claimedProcessId": 4242,
        "claimedSessionId": "session-alpha",
        "compactAnchorEntryId": null,
        "compactSessionId": null,
        "completedCompactionEntryId": null,
        "completedSessionId": null,
        "error": null,
        "force": false,
        "id": "session-maintenance:1:signal-researcher:compact",
        "interruptedSessionId": null,
        "personId": "signal-researcher",
        "recoveredFromRequestId": null,
        "requestedBy": "signal-researcher",
        "retryNotBefore": null,
        "status": "running"
      }
    },
    {
      "read": "maint.summary",
      "equals": {
        "requestOrder": [
          "session-maintenance:1:signal-researcher:compact"
        ]
      }
    }
  ]
}
