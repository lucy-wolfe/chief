{
  "name": "require-ready-without-a-release-is-refused",
  "family": "activity",
  "description": "The structural change is gated on the owner's release; an awaiting_handoff transition does not satisfy it.",
  "invariants": [
    "D7"
  ],
  "setup": [
    {
      "op": "company.create",
      "in": {
        "template": "northstar"
      }
    },
    {
      "op": "activity.begin_transition",
      "in": {
        "personId": "signal-researcher",
        "action": "park",
        "reason": "Conformance park."
      }
    }
  ],
  "op": "activity.require_ready",
  "in": {
    "personId": "signal-researcher",
    "action": "park"
  },
  "expect": {
    "error": {
      "type": "Refused",
      "code": "handoff-required",
      "message": "Person 'signal-researcher' must release their graceful transition before park"
    }
  },
  "expectState": [
    {
      "read": "activity.transition",
      "args": {
        "transitionId": "transition:1:signal-researcher:park"
      },
      "equals": {
        "abandoned": false,
        "action": "park",
        "id": "transition:1:signal-researcher:park",
        "personId": "signal-researcher",
        "status": "awaiting_handoff"
      }
    },
    {
      "read": "activity.person",
      "args": {
        "personId": "signal-researcher"
      },
      "equals": {
        "activeTransitionId": "transition:1:signal-researcher:park",
        "idleSince": null,
        "lastDesiredActive": false,
        "lastEmploymentState": "active",
        "lastOperational": true,
        "personId": "signal-researcher"
      }
    },
    {
      "read": "activity.summary",
      "equals": {
        "nextTransitionSequence": 2,
        "personOrder": [
          "chief",
          "quant-head",
          "signal-researcher",
          "it-head"
        ],
        "transitionOrder": [
          "transition:1:signal-researcher:park"
        ]
      }
    }
  ]
}
