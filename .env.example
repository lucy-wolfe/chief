# Local-only credential for the launcher-managed fal.ai media skill.
# Copy to .env and set a real key. Never commit .env.
FAL_KEY=

# --- apps/api -----------------------------------------------------------
# Auth mode for the HTTP/SSE API: "on" (default) or "off".
# "on" REQUIRES both CHIEF_API_JWT_SECRET and CHIEF_API_OPERATOR_PUBKEYS and
# refuses to boot without them — deliberate fail-closed behaviour for a
# deployment. `bun run start` sets "off" for you on a local machine; set it
# here only if you are running apps/api some other way.
CHIEF_API_AUTH=off
# Where apps/api binds. Default 127.0.0.1:8791.
CHIEF_API_BIND=127.0.0.1:8791
